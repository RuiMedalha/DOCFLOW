# =============================================================================
# DocFlow API — environment template (COMMITTED, safe to share).
#
# Copy to `.env` and fill in your own values. Real `.env` is gitignored.
# Boot-time validation in `src/common/jwt.config.ts` rejects dev-/test-/etc-
# prefixed secrets — production deployments MUST generate fresh random values.
#
# Generate strong secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# =============================================================================

# ---- Database / infra ----
DATABASE_URL="postgresql://docflow:docflow@localhost:5432/docflow_dev?schema=public"
REDIS_URL="redis://localhost:6379"

# ---- S3-compatible storage ----
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET="docflow"
S3_REGION="us-east-1"

# ---- JWT secrets ----
# REPLACE before deploying. Must NOT start with dev-/test-/change-/secret-.
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
JWT_ISSUER="docflow"
JWT_AUDIENCE="docflow-api"
JWT_ACCESS_TTL="15m"

# ---- Other ----
CRON_SECRET=""

# ---- Inbound email webhook signing ----
# At least ONE of the three provider secrets must be set or DocFlow will
# reject every inbound webhook with HTTP 503 (fail-closed, AUDIT §5.1):
#   SENDGRID_INBOUND_SECRET   — HMAC-SHA256 shared secret for SendGrid's
#                                Inbound Parse webhook (legacy). Signature
#                                header: x-sendgrid-signature.
#   SENDGRID_WEBHOOK_PUBLIC_KEY — PEM-encoded ECDSA public key for
#                                SendGrid's Signed Email feature. Crypto
#                                is preferred — uses an asymmetric key
#                                so the server never sees the private
#                                half. See:
#   https://developers.sendgrid.com/docs/for-developers/signing-email/verifying-your-signed-email/
#   MAILGUN_WEBHOOK_SIGNING_KEY — HMAC-SHA256 for Mailgun's route events.
TWO_FACTOR_ISSUER="DocFlow"
