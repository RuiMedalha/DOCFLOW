# =============================================================================
# DocFlow API — environment template (COMMITTED, safe to share).
#
# Copy to `.env` and fill in your own values. Real `.env` is gitignored.
# Boot-time validation in `src/common/jwt.config.ts` rejects dev-/test-/etc-
# prefixed secrets — production deployments MUST generate fresh random values.
#
# Generate strong secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# =============================================================================

# ---- Database / infra ----
DATABASE_URL="postgresql://docflow:docflow@localhost:5432/docflow_dev?schema=public"
REDIS_URL="redis://localhost:6379"

# ---- S3-compatible storage ----
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET="docflow"
S3_REGION="us-east-1"

# ---- JWT secrets ----
# REPLACE before deploying. Must NOT start with dev-/test-/change-/secret-.
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
JWT_ISSUER="docflow"
JWT_AUDIENCE="docflow-api"
JWT_ACCESS_TTL="15m"

# ---- Other ----
CRON_SECRET=""
TWO_FACTOR_ISSUER="DocFlow"
